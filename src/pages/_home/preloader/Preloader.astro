---
import type { Locale } from '../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const words = t.home.preloader;
---

<div id="preloader" aria-hidden="true">
  <div class="preloader" data-anim="preloader">
    <div class="words">
      {words.map((word) => <p class="word" data-word>{word}</p>)}
    </div>
  </div>
  <div class="split-overlay" data-anim="preloader-split">
    <div class="words">
      {words.map((word) => <p class="word" data-word>{word}</p>)}
    </div>
  </div>
</div>

<script>
  import './animation';
</script>

<style>
  :global(html[data-astro-transition] #preloader) {
    display: none;
  }

  .preloader,
  .split-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    background-color: #1c1b19;
    color: #f4f1ea;
    touch-action: none;
  }

  .split-overlay {
    z-index: 59;
  }

  .preloader {
    z-index: 60;
  }

  .words {
    display: flex;
    height: 100%;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  @media (width >= 440px) {
    .words {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .word {
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-size: 2.5rem;
    font-style: italic;
    line-height: 1;
    animation: preloader-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .word:nth-child(2) {
    animation-delay: 0.14s;
  }

  .word:nth-child(3) {
    animation-delay: 0.28s;
  }

  @keyframes preloader-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (width >= 1025px) {
    .word {
      font-size: 4rem;
    }
  }
</style>
